---
/**
 * Renders the operator-supplied homepage article VERBATIM.
 *
 * Content comes from src/data/homepage-article.json, extracted mechanically
 * from the supplied .docx rather than re-typed. QA gate 13 diffs the rendered
 * page against src/data/homepage-article.txt on every build and fails if a
 * single word differs. Site chrome sits around this article, never inside it.
 *
 * Layout: everything before the first H2 (the H1, hero image and intro
 * paragraphs) sits in a two-column lead beside the `aside` slot, which carries
 * the contact form. The rest of the article runs beneath at full width.
 */
import ArticleBlocks from './ArticleBlocks.astro';
import { toNodes, type Block } from '../lib/article';
import blocks from '../data/homepage-article.json';

interface Props { heroImage?: string; heroAlt?: string }
const { heroImage, heroAlt = '' } = Astro.props;

const nodes = toNodes(blocks as Block[]);

const firstH2 = nodes.findIndex((n) => n.kind === 'h2');
const lead = firstH2 === -1 ? nodes : nodes.slice(0, firstH2);
const rest = firstH2 === -1 ? [] : nodes.slice(firstH2);
---
<div class="container-page pt-8 md:pt-10">
  <div class="grid gap-8 lg:gap-12 lg:grid-cols-[minmax(0,1fr)_23rem] lg:items-start">
    <div class="prose-article prose-wide prose-lead">
      <ArticleBlocks nodes={lead} heroImage={heroImage} heroAlt={heroAlt} />
    </div>
    <aside class="lg:sticky lg:top-28"><slot name="aside" /></aside>
  </div>
</div>
<article class="prose-article prose-wide container-page pb-12 md:pb-16">
  <ArticleBlocks nodes={rest} />
</article>
