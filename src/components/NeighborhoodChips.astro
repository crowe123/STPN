---
interface Props { items: string[]; label?: string }
const { items, label } = Astro.props;
---
{
  items.length > 0 && (
    <div>
      {label && <p class="font-display text-base font-bold uppercase tracking-[0.12em] text-primary">{label}</p>}
      <ul class="mt-3 flex flex-wrap gap-2">
        {items.map((n) => (
          <li class="rounded-sm border border-line bg-white px-3 py-1.5 text-[0.95rem] font-medium text-primary-dark shadow-card">
            {n}
          </li>
        ))}
      </ul>
    </div>
  )
}
