---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadCaptureForm from '../components/LeadCaptureForm.astro';
import StaticMap from '../components/StaticMap.astro';
import { BRAND, CONTACT, SITE } from '../config';
import { tel } from '../lib/site';
import { graph, organizationNode, websiteNode, webPageNode, breadcrumbNode } from '../lib/schema';

const path = '/contact/';
const title = `Contact ${BRAND.name} | Nashville Septic Service`;
const description = 'Call (615) 234-9048 for septic pumping in Nashville and Davidson County. A person answers, including outside office hours for backups.';
const trail = [{ name: 'Home', href: '/' }, { name: 'Contact', href: path }];
const schema = graph([organizationNode(), websiteNode(), webPageNode(path, title, description, SITE.lastReviewed), breadcrumbNode(path, trail)]);
---
<BaseLayout title={title} description={description} path={path} schema={schema}>
  <section class="container-page pt-6 pb-10">
    <Breadcrumbs trail={trail} />
    <h1 class="mt-6 text-[2rem] md:text-5xl leading-[1.13]">Contact {BRAND.name}</h1>
    <div class="mt-8 rounded-lg bg-primary text-white p-8 md:p-10">
      <p class="text-white/80 text-lg">A live person answers</p>
      <a href={tel} class="block mt-2 font-heading font-bold text-4xl md:text-6xl text-white hover:text-accent">{CONTACT.phoneDisplay}</a>
      <p class="mt-4 text-white/85 text-lg">{CONTACT.hoursHuman}</p>
    </div>
  </section>

  <section class="container-page pb-16 grid gap-10 lg:grid-cols-[1fr_26rem] lg:items-start">
    <div>
      <h2 class="text-2xl md:text-3xl">Where to find us</h2>
      <address class="not-italic mt-5 text-lg leading-relaxed">
        <span class="block font-heading font-bold text-xl">{BRAND.name}</span>
        <span class="block">{CONTACT.address.street}</span>
        <span class="block">{CONTACT.address.locality}, {CONTACT.address.region} {CONTACT.address.postalCode}</span>
        <a href={tel} class="block mt-3 font-bold text-accent-dark underline underline-offset-2">{CONTACT.phoneDisplay}</a>
        <a href={`mailto:${CONTACT.email}`} class="block mt-1 underline underline-offset-2 break-words">{CONTACT.email}</a>
      </address>

      <h2 class="mt-10 text-2xl md:text-3xl">Hours</h2>
      <ul class="mt-4 space-y-1.5 text-lg">
        {CONTACT.hours.map((h) => (
          <li><span class="font-semibold">{h.days.length > 1 ? `${h.days[0]}–${h.days[h.days.length - 1]}` : h.days[0]}:</span> {h.opens}–{h.closes}</li>
        ))}
        <li class="text-ink-soft">Septic backups answered outside these hours.</li>
      </ul>

      <h2 class="mt-10 text-2xl md:text-3xl">Where we work</h2>
      <p class="mt-4 text-lg text-ink-soft max-w-2xl">
        {CONTACT.serviceAreaLong}. That means Joelton, Whites Creek, Forest Hills, Oak Hill,
        Bellevue and Pasquo, Bells Bend and Scottsboro, and Goodlettsville — the parts of the county
        still on septic. If you are unsure whether you are on septic or sewer, call and we will help
        you work it out before anyone drives anywhere.
      </p>
      <div class="mt-8">
        <StaticMap cityName={CONTACT.address.locality} neighborhoods={['Joelton', 'Whites Creek', 'Goodlettsville', 'Bells Bend', 'Bellevue', 'Oak Hill']} />
      </div>
    </div>
    <LeadCaptureForm source="contact-page" heading="Or send us the details"
      body="Two quick steps. We reply with a firm price, not a callback to ask more questions." submitLabel="Send it" />
  </section>
</BaseLayout>
