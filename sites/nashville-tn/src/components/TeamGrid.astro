---
import proof from '../data/proof.json';
/* DORMANT. No stock headshots, no invented staff. Real named people only. */
const items = proof.team ?? [];
---
{items.length > 0 && (
  <section class="container-page py-16">
    <h2 class="text-3xl md:text-4xl mb-8">The team</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((m: any) => (
        <div class="card p-5">
          <p class="font-heading font-bold text-lg">{m.name}</p>
          <p class="text-[15px] text-ink-soft">{m.role}</p>
        </div>
      ))}
    </div>
  </section>
)}
