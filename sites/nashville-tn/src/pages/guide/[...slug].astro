---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import LeadCaptureForm from '../../components/LeadCaptureForm.astro';
import { BRAND, CONTACT } from '../../config';
import { tel, fmtDate } from '../../lib/site';
import { graph, organizationNode, websiteNode, webPageNode, breadcrumbNode, faqNode, articleNode } from '../../lib/schema';
import servicesData from '../../data/services.json';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  // Filter empty ids so this dynamic route cannot collide with /guide/ index.
  return guides.filter((g) => g.id).map((g) => ({ params: { slug: g.id }, props: { entry: g, all: guides } }));
}
const { entry, all } = Astro.props;
// Standalone render() from astro:content — entry.render() does not exist with the glob loader.
const { Content } = await render(entry);
const d = entry.data;
const path = `/guide/${entry.id}/`;
const parent = servicesData.services.find((s) => s.slug === d.parentService)!;
const trail = [{ name: 'Home', href: '/' }, { name: parent.name, href: `/${parent.slug}/` }, { name: d.h1, href: path }];
const siblings = (d.siblings ?? [])
  .map((s: string) => all.find((g: any) => g.id === s))
  .filter(Boolean)
  .slice(0, 5) as any[];
const schema = graph([
  organizationNode(), websiteNode(), webPageNode(path, d.title, d.description, d.dateModified),
  breadcrumbNode(path, trail), faqNode(path, d.faq),
  articleNode(path, { headline: d.h1, description: d.description, published: d.datePublished, modified: d.dateModified, aboutServiceSlug: parent.slug }),
]);
---
<BaseLayout title={d.title} description={d.description} path={path} schema={schema} ogType="article">
  <div class="container-page pt-6 pb-14">
    <Breadcrumbs trail={trail} />
    <div class="mt-6 grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-14">
      <article>
        <p class="text-[12px] font-bold uppercase tracking-wide text-accent-dark">{d.badge}</p>
        <h1 class="mt-2 text-[2rem] leading-[1.15] md:text-[2.9rem]">{d.h1}</h1>
        <p class="mt-4 text-xl text-ink-soft leading-relaxed">{d.dek}</p>

        <div class="mt-7 border-l-4 border-accent bg-surface p-5 md:p-6 rounded-r-md">
          <p class="text-lg md:text-xl leading-relaxed font-medium">{d.answer}</p>
        </div>

        <p class="mt-5 text-[14px] text-ink-soft">
          Published {fmtDate(d.datePublished)} · Last updated {fmtDate(d.dateModified)} · By {BRAND.name}
        </p>

        <div class="prose-article mt-8">
          <Content />
        </div>

        <div class="mt-10">
          <LeadCaptureForm source={`guide-${entry.id}`}
            heading="Want this looked at properly?"
            body={`Two steps and we come back with a firm price. Or call ${CONTACT.phoneDisplay} — a person answers.`} />
        </div>
      </article>

      <aside class="lg:sticky lg:top-28 space-y-5 self-start">
        <a href={`/${parent.slug}/`} class="card card-hover p-6 block">
          <p class="text-[12px] font-bold uppercase tracking-wide text-accent-dark">Related service</p>
          <p class="mt-1.5 font-heading font-bold text-xl">{parent.name}</p>
          <p class="mt-2 text-[15px] text-ink-soft">{parent.blurb}</p>
          <p class="mt-3 font-semibold text-accent-dark">See {parent.name.toLowerCase()} →</p>
        </a>
        <div class="card p-6 bg-primary text-white">
          <p class="font-heading font-bold text-lg">Talk to someone</p>
          <p class="mt-2 text-[15px] text-white/85">{CONTACT.hoursHuman}</p>
          <a href={tel} class="btn bg-white text-primary-dark hover:bg-white/90 w-full mt-4">Call {CONTACT.phoneDisplay}</a>
        </div>
        {siblings.length > 0 && (
          <div class="card p-6">
            <p class="font-heading font-bold">More on this</p>
            <ul class="mt-3 space-y-2.5 text-[15px]">
              {siblings.map((g: any) => (
                <li><a href={`/guide/${g.id}/`} class="underline underline-offset-2 hover:text-accent-dark">{g.data.h1}</a></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>

  <FaqAccordion faq={d.faq} heading="Quick answers" headingLevel={2} />
  <CtaBand heading="Bottom line: get the tank opened and looked at."
           body={`Call ${CONTACT.phoneDisplay} for a price, or use the estimator first.`} ctaLabel="Get a price" />
</BaseLayout>
