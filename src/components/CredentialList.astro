---
/**
 * DORMANT PROOF COMPONENT.
 * Wired to src/data/proof.json → credentials[]. Returns null on an empty array.
 * Only certifications that exist and can be produced on request. When empty,
 * schema omits hasCredential entirely rather than inventing one — knowsAbout
 * carries the expertise signal instead.
 */
import Icon from './Icon.astro';
import { proof } from '../lib/data';
const items = proof.credentials;
---
{
  items.length > 0 && (
    <div>
      <h3 class="text-2xl">Certifications</h3>
      <hr class="rule-accent" />
      <ul class="mt-5 space-y-3">
        {items.map((c) => (
          <li class="flex items-start gap-3">
            <Icon name="shield" size={22} class="mt-0.5 shrink-0 text-primary" />
            <span>
              <span class="font-semibold text-primary-dark">{c.name}</span>
              <span class="block text-sm text-ink-soft">
                {c.issuer}
                {c.id ? ` · ${c.id}` : ''}
              </span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  )
}
