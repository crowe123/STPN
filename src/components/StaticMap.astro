---
/**
 * Service-area graphic. Deliberately NOT a Google Maps iframe — third-party
 * iframes are the single heaviest thing on a page and the local signal survives
 * without them. Wrapped in a link out to Google Maps for the locality.
 *
 * The artwork is a real <img> served from public/images/coverage/<slug>.svg,
 * built by scripts/gen-maps.mjs. It used to be inlined per page; a file is
 * cached across every page that shows it, and pages that carry no <img> at all
 * take a measured AIO/M retrieval penalty.
 *
 * Pin placement lives in the generator, not here — pass `slug`, and the file
 * for that slug already has the right pins drawn on it. The pins are
 * unlabelled: names are set as text below the map so long ones cannot collide
 * or overflow the frame, and so they read as page text rather than image text.
 */
import Icon from './Icon.astro';
import { CONTACT } from '../config';

interface Props {
  slug: string;
  cityName: string;
  state?: string;
  neighborhoods?: string[];
  routes?: string[];
  caption?: string;
  loading?: 'lazy' | 'eager';
}
const {
  slug,
  cityName,
  state = CONTACT.address.region,
  neighborhoods = [],
  routes = [],
  caption,
  loading = 'lazy',
} = Astro.props;
// The generator draws one pin per name, capped at six — keep the two in step.
const pinned = neighborhoods.slice(0, 6);
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${cityName}, ${state}`)}`;
---
<figure class="overflow-hidden rounded border border-line bg-white shadow-card">
  <a href={mapUrl} target="_blank" rel="noopener nofollow" class="block" aria-label={`Open ${cityName}, ${state} in Google Maps`}>
    <img
      src={`/images/coverage/${slug}.svg`}
      alt={`Map of the septic service coverage area around ${cityName}, ${state}, with the neighborhoods served marked`}
      width="400"
      height="260"
      class="h-auto w-full"
      loading={loading}
      decoding="async"
    />
  </a>
  <figcaption class="border-t border-line px-4 py-3 text-sm leading-relaxed text-ink-soft">
    <span class="inline-flex items-center gap-1.5 font-semibold text-primary-dark">
      <Icon name="map" size={16} /> Coverage around {cityName}
    </span>
    {pinned.length > 0 && <span> — pins mark {pinned.join(', ')}.</span>}
    {routes.length > 0 && <span> Reached via {routes.slice(0, 3).join(', ')}.</span>}
    {caption && <span> {caption}</span>}
    <a href={mapUrl} target="_blank" rel="noopener nofollow" class="ml-1 inline-flex min-h-11 items-center underline md:min-h-0">Open in Google Maps</a>
  </figcaption>
</figure>
