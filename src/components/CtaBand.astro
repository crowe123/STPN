---
import Icon from './Icon.astro';
import { CONTACT, tel } from '../config';

interface Props {
  /** CTA copy mirrors the page's search intent — never generic "Contact Us". */
  heading: string;
  body?: string;
  callLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  tone?: 'primary' | 'alert';
}
const {
  heading,
  body,
  callLabel = `Call ${CONTACT.phoneDisplay}`,
  secondaryHref = '/contact/',
  secondaryLabel = 'Get a Free Estimate',
  tone = 'primary',
} = Astro.props;
---
<section class:list={['section', tone === 'alert' ? 'bg-alert text-white' : 'section-dark']}>
  <div class="container-site grid items-center gap-8 md:grid-cols-[1fr_auto]">
    <div>
      <p class="font-display text-3xl font-bold uppercase leading-tight text-white md:text-4xl">{heading}</p>
      {body && <p class="mt-3 max-w-2xl text-lg text-white/85">{body}</p>}
    </div>
    <div class="flex flex-col gap-3 sm:flex-row md:flex-col lg:flex-row">
      <a href={tel} class="btn btn-accent" data-cta="cta-band-call">
        <Icon name="phone" size={20} />{callLabel}
      </a>
      <a href={secondaryHref} class="btn btn-ghost-light">{secondaryLabel}</a>
    </div>
  </div>
</section>
