---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { BRAND, CONTACT } from '../../config';
import { fmtDate } from '../../lib/site';
import { graph, organizationNode, websiteNode, webPageNode, breadcrumbNode, articleNode } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter((p) => p.id).map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/blog/${entry.id}/`;
const trail = [{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }, { name: d.h1, href: path }];
const schema = graph([
  organizationNode(), websiteNode(), webPageNode(path, d.title, d.description, d.dateModified),
  breadcrumbNode(path, trail),
  articleNode(path, { headline: d.h1, description: d.description, published: d.datePublished, modified: d.dateModified }),
]);
---
<BaseLayout title={d.title} description={d.description} path={path} schema={schema} ogType="article">
  <div class="container-page pt-6 pb-14 max-w-3xl">
    <Breadcrumbs trail={trail} />
    <p class="mt-6 text-[12px] font-bold uppercase tracking-wide text-accent-dark">{d.category}</p>
    <h1 class="mt-2 text-[2rem] leading-[1.15] md:text-[2.9rem]">{d.h1}</h1>
    <p class="mt-4 text-xl text-ink-soft leading-relaxed">{d.dek}</p>
    <p class="mt-4 text-[14px] text-ink-soft">
      Published {fmtDate(d.datePublished)} · Last updated {fmtDate(d.dateModified)} · By {BRAND.name}
    </p>
    <div class="prose-article mt-8"><Content /></div>
  </div>
  <CtaBand heading="Need the tank looked at?" body={`Call ${CONTACT.phoneDisplay}. ${CONTACT.hoursHuman}`} ctaLabel="Get a price" />
</BaseLayout>
