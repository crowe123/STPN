---
import proof from '../data/proof.json';
/* DORMANT. Real certifications only — never an invented licence or association. */
const items = proof.credentials ?? [];
---
{items.length > 0 && (
  <div class="card p-5">
    <p class="font-heading font-bold mb-3">Credentials</p>
    <ul class="space-y-2 text-[15px]">
      {items.map((c: any) => <li>{c.name}{c.issuer ? ` — ${c.issuer}` : ''}</li>)}
    </ul>
  </div>
)}
