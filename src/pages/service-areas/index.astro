---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHead from '../../components/SectionHead.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import TickerBar from '../../components/TickerBar.astro';
import StaticMap from '../../components/StaticMap.astro';
import { CONTACT } from '../../config';
import { primaryCities, secondaryCities, subCities, cities } from '../../lib/data';
import { graph, organization, website, webPage, breadcrumbs } from '../../lib/schema';

const path = '/service-areas/';
const title = 'Septic Service Areas in Davidson County TN | 615 Septic Tank Pumping';
const description =
  `Septic pumping and inspection across Davidson County, TN — Bellevue, Antioch, Hermitage, Donelson, Madison, Joelton and more. Call ${CONTACT.phoneDisplay}.`;
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Service Areas', path },
];
const schema = graph([organization(), website(), webPage({ path, title, description }), breadcrumbs(trail)]);

const allZips = [...new Set(cities.flatMap((c) => c.zips))].sort();
---
<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs trail={trail} />
  <section class="bg-offwhite py-12 md:py-16">
    <div class="container-site grid items-center gap-10 lg:grid-cols-[1.1fr_.9fr]">
      <div>
        <p class="eyebrow">{CONTACT.county}, Tennessee</p>
        <h1 class="mt-2 font-display text-[2.4rem] leading-[1.06] text-primary-dark sm:text-5xl">
          Septic Service Areas Across Davidson County, TN
        </h1>
        <hr class="rule-accent" />
        <p class="mt-6 max-w-2xl text-xl leading-relaxed text-ink">
          Davidson County is not one septic problem. Ridge lots in Bellevue and Joelton sit on thin soil over fractured
          limestone; Neelys Bend and Pennington Bend sit on river bottomland with a water table that rises every spring;
          Madison and Donelson run on mid-century tanks whose baffles have quietly corroded away. Each area page covers
          the ground, the housing stock and the failure pattern specific to that part of the county.
        </p>
        <p class="mt-4 text-[1.0625rem] text-ink-soft">
          ZIP codes covered: {allZips.join(', ')} and the surrounding Davidson County service area.
        </p>
      </div>
      <StaticMap
        cityName={CONTACT.address.locality}
        neighborhoods={primaryCities.map((c) => c.name)}
        routes={['I-40', 'I-24', 'Briley Parkway']}
        caption="Coverage radius approximately 25 miles from central Nashville."
      />
    </div>
  </section>

  <TickerBar />

  <section class="section">
    <div class="container-site">
      <SectionHead
        eyebrow="Primary areas"
        heading="Where most of the work is"
        lede="Full septic service — pumping, cleaning, inspection, drain field assessment and emergency response — with same-day and next-day slots normal."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          primaryCities.map((c) => (
            <a href={`/service-areas/${c.slug}/`} class="card card-hover flex flex-col p-6">
              <h3 class="text-2xl text-primary-dark">{c.name}, {c.state}</h3>
              <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-accent-dark">ZIP {c.zips.join(', ')}</p>
              <p class="mt-3 flex-1 text-[1.0625rem] leading-relaxed text-ink-soft">
                {c.localAngle[0].split('. ').slice(0, 2).join('. ')}.
              </p>
              <p class="mt-4 inline-flex items-center gap-2 font-display text-sm font-bold uppercase tracking-widest text-primary-light">
                {c.name} septic service <Icon name="arrow" size={16} />
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container-site">
      <SectionHead
        eyebrow="Also covered"
        heading="Secondary areas"
        lede="Next-day slots are the norm here, with emergency dispatch outside those windows."
      />
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {
          secondaryCities.map((c) => (
            <a href={`/service-areas/${c.slug}/`} class="card card-hover flex flex-col p-6">
              <h3 class="text-xl text-primary-dark">{c.name}, {c.state}</h3>
              <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-accent-dark">ZIP {c.zips.join(', ')}</p>
              <p class="mt-2 text-[1.0625rem] leading-relaxed text-ink-soft">
                {c.localAngle[0].split('. ')[0]}.
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <SectionHead
        eyebrow="Smaller communities"
        heading="Rural and satellite areas of Davidson County"
        lede="The parts of the county where septic is not the exception but the only option — and where most properties draw their drinking water from a private well on the same lot."
      />
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          subCities.map((c) => (
            <a href={`/service-areas/${c.slug}/`} class="card card-hover p-5">
              <h3 class="text-lg text-primary-dark">{c.name}</h3>
              <p class="mt-1.5 text-[1rem] leading-relaxed text-ink-soft">{c.localAngle[0].split('. ')[0]}.</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    heading="Not sure whether an address is covered?"
    body={`We cover ${CONTACT.serviceArea}. Call with the address and you will get a straight yes or no, plus the next available slot.`}
    secondaryLabel="Send the address"
  />
</Base>
