---
import type { ProcessStep } from '../lib/data';

interface Props { steps: ProcessStep[]; headingLevel?: 3 | 4 }
const { steps, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}` as 'h3' | 'h4';
---
<ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
  {
    steps.map((s, i) => (
      <li id={`step-${i + 1}`} class="card relative flex flex-col p-6 pt-8">
        <span
          aria-hidden="true"
          class="absolute -top-4 left-6 flex h-11 w-11 items-center justify-center rounded bg-primary font-display text-xl font-bold text-white"
        >
          {String(i + 1).padStart(2, '0')}
        </span>
        <H class="text-lg leading-snug">{s.step}</H>
        <p class="mt-2 text-[1.0625rem] leading-relaxed text-ink-soft">{s.detail}</p>
      </li>
    ))
  }
</ol>
