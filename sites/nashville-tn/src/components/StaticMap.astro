---
import { CONTACT } from '../config';
/* No iframe. Third-party map embeds are the single heaviest thing on the donor
   sites. This is an inline SVG service-area graphic wrapped in a link out to
   Google Maps — same local signal, zero third-party JavaScript, no CLS. */
interface Props { cityName: string; neighborhoods?: string[] }
const { cityName, neighborhoods = [] } = Astro.props;
const q = encodeURIComponent(`${cityName}, ${CONTACT.address.region}`);
const ring = neighborhoods.slice(0, 6);
---
<a href={`https://www.google.com/maps/search/?api=1&query=${q}`} target="_blank" rel="noopener noreferrer"
   class="card card-hover block overflow-hidden" aria-label={`Open ${cityName} in Google Maps`}>
  <svg viewBox="0 0 640 340" width="640" height="340" class="w-full h-auto bg-surface" role="img"
       aria-label={`Service area map for ${cityName}, ${CONTACT.address.region}`}>
    <defs>
      <pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse">
        <path d="M32 0H0v32" fill="none" stroke="#E2DCD1" stroke-width="1"/>
      </pattern>
    </defs>
    <rect width="640" height="340" fill="url(#grid)"/>
    <path d="M-10 250 C 120 220, 200 300, 330 250 S 520 170, 660 210" fill="none" stroke="#9EC6D8" stroke-width="14" stroke-linecap="round" opacity="0.55"/>
    <path d="M0 120 L640 96" stroke="#CFC7B8" stroke-width="7"/>
    <path d="M180 0 L232 340" stroke="#CFC7B8" stroke-width="7"/>
    <circle cx="320" cy="170" r="96" fill="#1E4634" opacity="0.07"/>
    <circle cx="320" cy="170" r="96" fill="none" stroke="#1E4634" stroke-width="2" stroke-dasharray="7 6" opacity="0.5"/>
    <circle cx="320" cy="170" r="11" fill="#C2571A"/>
    <circle cx="320" cy="170" r="20" fill="none" stroke="#C2571A" stroke-width="2.5" opacity="0.6"/>
    <text x="320" y="212" text-anchor="middle" font-family="Bitter, Georgia, serif" font-size="25" font-weight="700" fill="#143024">{cityName}</text>
    <text x="320" y="236" text-anchor="middle" font-family="system-ui, sans-serif" font-size="14" fill="#4A524D">{CONTACT.county}, {CONTACT.address.region}</text>
    {ring.map((n, i) => {
      const a = (i / Math.max(ring.length, 1)) * Math.PI * 2 - Math.PI / 2;
      const x = 320 + Math.cos(a) * 138, y = 170 + Math.sin(a) * 108;
      return <g><circle cx={x} cy={y} r="4" fill="#2C6349"/><text x={x} y={y - 11} text-anchor="middle" font-family="system-ui, sans-serif" font-size="12.5" fill="#4A524D">{n}</text></g>;
    })}
  </svg>
  <span class="block px-4 py-3 text-[14px] font-semibold text-accent-dark">Open {cityName} in Google Maps →</span>
</a>
