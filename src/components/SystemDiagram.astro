---
/**
 * Cross-section of a conventional gravity septic system.
 *
 * This is real explanatory artwork, not a placeholder standing in for a photo:
 * it names the components the rest of the site refers to (inlet and outlet
 * baffles, the three layers inside the tank, the distribution box, the
 * laterals) so the copy has something to point at.
 *
 * Served as a file rather than inlined. Two reasons: the page carried zero
 * <img> elements, which is a measured AIO/M retrieval penalty on its own, and
 * inlining put the diagram's own labels ("SCUM", "CLEAR EFFLUENT", "Inlet
 * baffle"...) into the page's text layer, where they extracted as ~100 words of
 * nonsense prose between two real paragraphs. As a file the artwork is cached
 * across all 65 pages, the text layer stays clean, and the meaning survives in
 * alt plus the figcaption. The standalone file sets an explicit font stack —
 * an <img>-referenced SVG cannot see the document's webfonts.
 */
interface Props { class?: string; compact?: boolean }
const { class: className = '', compact = false } = Astro.props;

const alt =
  'Cross-section of a conventional septic system: waste leaves the house through the building drain and enters ' +
  'the tank at the inlet baffle, separating into a floating scum layer, a clear effluent zone, and settled sludge. ' +
  'Only the clear middle layer passes the outlet baffle to the distribution box and drain field laterals. Pumping ' +
  'removes the scum and sludge layers.';
---
<figure class={className}>
  <img
    src="/images/septic-system-cross-section.svg"
    alt={alt}
    width="900"
    height="440"
    class="h-auto w-full"
    loading="eager"
    decoding="async"
  />
  {
    !compact && (
      <figcaption class="mt-3 text-sm leading-relaxed text-ink-soft">
        A conventional gravity system. Solids settle as sludge, fats float as scum, and only the clear middle layer is
        meant to pass the outlet baffle into the drain field. When the tank runs past its interval that clear zone
        narrows, the outlet starts drawing solids, and the field — the part that cannot be serviced — takes the damage.
      </figcaption>
    )
  }
</figure>
