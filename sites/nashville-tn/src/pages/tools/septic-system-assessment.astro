---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import UrgencyQuiz from '../../components/islands/UrgencyQuiz';
import { SITE, CONTACT } from '../../config';
import { graph, organizationNode, websiteNode, webPageNode, breadcrumbNode, webApplicationNode } from '../../lib/schema';
import quiz from '../../data/quiz.json';
const path = '/tools/septic-system-assessment/';
const title = `Septic Urgency Assessment | Is It An Emergency? | ${SITE.titleSuffix}`;
const description = 'Nine questions about what your septic system is doing, and a severity reading with clear next steps. Free, immediate, no email required.';
const trail = [{ name: 'Home', href: '/' }, { name: 'Free Tools', href: '/tools/' }, { name: 'Urgency Assessment', href: path }];
const schema = graph([
  organizationNode(), websiteNode(), webPageNode(path, title, description, SITE.lastReviewed),
  breadcrumbNode(path, trail),
  webApplicationNode(path, 'Septic Urgency Assessment', description),
]);
---
<BaseLayout title={title} description={description} path={path} schema={schema}>
  <section class="container-page pt-6 pb-8 border-b border-hairline">
    <Breadcrumbs trail={trail} />
    <h1 class="mt-6 text-[2rem] md:text-5xl leading-[1.13]">Septic Urgency Assessment</h1>
    <p class="mt-5 max-w-3xl text-lg md:text-xl text-ink-soft leading-relaxed">{quiz.intro}</p>
    <p class="mt-4 max-w-3xl text-[15px] text-ink-soft">
      If sewage is backing up into your house right now, do not fill in a questionnaire.
      Stop all water use and call <a href={`tel:${CONTACT.phoneE164}`} class="font-bold text-accent-dark underline underline-offset-2">{CONTACT.phoneDisplay}</a>.
    </p>
  </section>
  <section class="container-page py-12 max-w-3xl">
    <UrgencyQuiz client:visible phone={CONTACT.phoneDisplay} />
  </section>
  <CtaBand heading="Whatever the result says, a person can tell you more in two minutes."
           body={CONTACT.hoursHuman} ctaLabel="Get a price" />
</BaseLayout>
