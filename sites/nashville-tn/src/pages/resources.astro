---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { CONTACT, SITE, FORMS } from '../config';
import { graph, organizationNode, websiteNode, webPageNode, breadcrumbNode } from '../lib/schema';
const path = '/resources/';
const title = `Free Septic Pre-Hire Checklist | ${SITE.titleSuffix}`;
const description = 'A printable checklist of what to ask before hiring anyone to pump your septic tank, and what a proper job includes. Free download.';
const trail = [{ name: 'Home', href: '/' }, { name: 'Resources', href: path }];
const schema = graph([organizationNode(), websiteNode(), webPageNode(path, title, description, SITE.lastReviewed), breadcrumbNode(path, trail)]);
const checklist = [
  'Will you pump the tank completely — liquid, scum and settled sludge — or only draw down the liquid?',
  'Will you measure and record sludge and scum depth before pumping?',
  'Will you open both access points, or only the nearest one?',
  'Will you inspect the inlet and outlet baffles while the tank is empty?',
  'Will you locate, clean and inspect the effluent filter — and tell me if there is not one fitted?',
  'What does the quote include, and what would make the price change once you are here?',
  'Do you charge extra to hand-dig a buried lid, and how much?',
  'Will I get a written record of what was found, or just an invoice?',
  'What pumping interval do you recommend for my tank, and what is that based on?',
  'Where is the septage disposed of?',
];
---
<BaseLayout title={title} description={description} path={path} schema={schema}>
  <section class="container-page pt-6 pb-10 border-b border-hairline">
    <Breadcrumbs trail={trail} />
    <h1 class="mt-6 text-[2rem] md:text-5xl leading-[1.13]">The Septic Pre-Hire Checklist</h1>
    <p class="mt-5 max-w-3xl text-lg md:text-xl text-ink-soft leading-relaxed">
      Ten questions to ask any septic company before you book — including us. The difference between
      a cheap pump-out and a proper one is entirely in the answers to these.
    </p>
  </section>
  <section class="container-page py-14 grid gap-10 lg:grid-cols-[1fr_24rem] lg:items-start">
    <div>
      <h2 class="text-2xl md:text-3xl">What is on it</h2>
      <ol class="mt-6 space-y-3">
        {checklist.map((q, i) => (
          <li class="flex gap-3.5 text-lg">
            <span class="font-heading font-bold text-accent shrink-0">{String(i + 1).padStart(2, '0')}</span>
            <span>{q}</span>
          </li>
        ))}
      </ol>
      <p class="mt-8 text-lg text-ink-soft max-w-2xl">
        Print it, keep it by the phone, and use it on every quote you get. If a company will not
        answer question one straight, you have learned what you needed to know.
      </p>
    </div>
    <div class="card p-6 md:p-7">
      <img src="/images/resources-checklist-preview.webp" alt="Printable septic pre-hire checklist, one page"
           width="640" height="828" loading="lazy" decoding="async"
           class="w-full h-auto rounded border border-hairline" />
      <p class="mt-5 font-heading font-bold text-xl">Get the printable version</p>
      <p class="mt-2 text-[15px] text-ink-soft">One page, printer-friendly. Tell us where to send it.</p>
      <form action={FORMS.endpoint} method="POST" class="mt-5 space-y-3">
        <input type="hidden" name="_source" value="resources-checklist" />
        <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;">
          <input type="text" name={FORMS.honeypotField} tabindex="-1" autocomplete="off" />
        </div>
        <label class="block"><span class="block font-semibold mb-1.5">Email</span>
          <input name="email" type="email" required class="w-full min-h-[44px] border border-hairline rounded-md px-3 py-2.5" /></label>
        <label class="block"><span class="block font-semibold mb-1.5">Phone</span>
          <input name="phone" type="tel" required class="w-full min-h-[44px] border border-hairline rounded-md px-3 py-2.5" /></label>
        <button type="submit" class="btn btn-accent w-full">Send me the checklist</button>
      </form>
      <p class="mt-3 text-[13px] text-ink-soft">We use this to send the checklist and to answer you if you ask something. Nothing else.</p>
    </div>
  </section>
  <CtaBand heading="Or skip the checklist and just ask us the ten questions."
           body={`Call ${CONTACT.phoneDisplay}. We will answer all of them.`} ctaLabel="Get a price" />
</BaseLayout>
