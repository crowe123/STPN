---
/**
 * Homepage. The body is the operator-supplied article, rendered VERBATIM by
 * HomepageArticle.astro and diffed against its source on every build (QA gate
 * 13). Site chrome — header, footer, sticky call bar — wraps it and never
 * appears inside it. No CTA bands are injected into the article itself; the
 * operator-requested contact form sits after it, posting to the supplied
 * Formspree endpoint.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HomepageArticle from '../components/HomepageArticle.astro';
import LeadCaptureForm from '../components/LeadCaptureForm.astro';
import { BRAND, SITE } from '../config';
import { graph, organizationNode, websiteNode, webPageNode, faqNode } from '../lib/schema';
import blocks from '../data/homepage-article.json';

const path = '/';
const title = 'Septic Tank Pumping Nashville : Licensed Crews';
const description = 'Septic tank pumping in Nashville and Davidson County. Residential and commercial tanks pumped by licensed local crews.';

/* FAQPage schema is built from the article's own FAQ section — the visible Q&A
   on the page, never from separate unrendered data. The FAQ runs from the
   "Frequently Asked Questions" H2 to the end, as H3 question / paragraph pairs. */
type B = { type: string; style?: string; list?: boolean; text?: string };
const items = blocks as B[];
const faqStart = items.findIndex((b) => b.style === 'Heading2' && /Frequently Asked Questions/i.test(b.text ?? ''));
const faq: { q: string; a: string }[] = [];
if (faqStart >= 0) {
  for (let i = faqStart + 1; i < items.length; i++) {
    const b = items[i];
    if (b.style === 'Heading3' && b.text) {
      const ans = items[i + 1];
      if (ans && ans.type === 'p' && ans.style === 'Normal' && ans.text) faq.push({ q: b.text, a: ans.text });
    }
  }
}

const heroImage = '/images/home-hero.webp';
const heroAlt = 'Septic pump truck with its hose run across a Davidson County lawn to an open concrete tank lid';

const schema = graph([
  organizationNode(), websiteNode(),
  webPageNode(path, title, description, SITE.lastReviewed),
  ...(faq.length ? [faqNode(path, faq)] : []),
]);
---
<BaseLayout title={title} description={description} path={path} schema={schema} heroPreload={heroImage}>
  <HomepageArticle heroImage={heroImage} heroAlt={heroAlt}>
    <LeadCaptureForm slot="aside" source="homepage" compact
      heading="Request septic service"
      body="Tell us the service and your ZIP, then how to reach you. We reply with a firm price."
      submitLabel="Request service" />
  </HomepageArticle>
</BaseLayout>
