---
/**
 * SERVICE PAGES — flat at the root, no /services/ prefix.
 * Core services ~1,000–1,200 words; long-tail variants ~600–800 with the
 * headings and substance genuinely shifted to the specific context.
 *
 * Static routes (about.astro, contact.astro, …) take precedence over this
 * dynamic route in Astro, so only the slugs returned below are generated.
 */
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TickerBar from '../components/TickerBar.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import RelatedServices from '../components/RelatedServices.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import CtaBand from '../components/CtaBand.astro';
import LeadCaptureForm from '../components/LeadCaptureForm.astro';
import CredentialList from '../components/CredentialList.astro';
import SystemDiagram from '../components/SystemDiagram.astro';
import { BRAND, CONTACT, SITE, tel, napify } from '../config';
import { services, GLOBAL_FAQ, KNOWS_ABOUT, type Service } from '../lib/data';
import { graph, organization, website, webPage, breadcrumbs, faqPage, serviceNode, howTo } from '../lib/schema';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props as { service: Service };
const path = `/${service.slug}/`;
const description = napify(service.description);

const faqs = [...service.faq, GLOBAL_FAQ];
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services-menu/' },
  { name: service.name, path },
];

const schema = graph([
  organization(),
  website(),
  webPage({ path, title: service.title, description }),
  breadcrumbs(trail),
  serviceNode(service),
  howTo(service),
  faqPage(path, faqs),
]);

const priceLine =
  service.priceFrom !== null
    ? `$${service.priceFrom}${service.priceTo ? `–$${service.priceTo}` : '+'} typical`
    : 'Quoted per property';
---

<Base title={service.title} description={description} path={path} schema={schema}>
  <Breadcrumbs trail={trail} />

  <section class="bg-offwhite">
    <div class="container-site grid items-start gap-10 py-12 lg:grid-cols-[1.1fr_.9fr] lg:py-16">
      <div>
        <p class="eyebrow">
          {service.tier === 'longtail' ? 'Specialist service' : 'Core service'} · {CONTACT.serviceArea}
        </p>
        <h1 class="mt-2 font-display text-[2.4rem] leading-[1.06] text-primary-dark sm:text-5xl">{service.h1}</h1>
        <hr class="rule-accent" />
        <p class="mt-6 max-w-2xl text-xl leading-relaxed text-ink">{service.blurb}</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a href={tel} class="btn btn-accent" data-cta="service-hero-call">
            <Icon name="phone" size={22} /> Call {CONTACT.phoneDisplay}
          </a>
          <a href="#book" class="btn btn-outline">Book this service</a>
        </div>
        <dl class="mt-8 grid gap-4 sm:grid-cols-3">
          <div class="rounded border border-line bg-white p-4">
            <dt class="font-display text-xs font-bold uppercase tracking-[0.14em] text-ink-soft">Typical price</dt>
            <dd class="mt-1 font-display text-2xl font-bold text-primary-dark">{priceLine}</dd>
          </div>
          <div class="rounded border border-line bg-white p-4">
            <dt class="font-display text-xs font-bold uppercase tracking-[0.14em] text-ink-soft">Coverage</dt>
            <dd class="mt-1 font-display text-2xl font-bold text-primary-dark">{CONTACT.county}</dd>
          </div>
          <div class="rounded border border-line bg-white p-4">
            <dt class="font-display text-xs font-bold uppercase tracking-[0.14em] text-ink-soft">You leave with</dt>
            <dd class="mt-1 font-display text-2xl font-bold text-primary-dark">Written findings</dd>
          </div>
        </dl>
      </div>
      <SystemDiagram compact class="rounded border border-line bg-white p-4 shadow-card" />
    </div>
  </section>

  <TickerBar />

  <div class="container-site grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:py-16">
    <!-- ── ARTICLE ─────────────────────────────────────────────────────── -->
    <article class="prose-site max-w-none">
      <p class="text-sm font-semibold uppercase tracking-wide text-ink-soft">
        Last updated: {SITE.lastReviewed}
      </p>
      <p>
        <a href="/" class="font-semibold">{BRAND.name}</a> {service.intro.replace(`${BRAND.name} `, '')}
      </p>

      <h2>What happens on the first visit</h2>
      <p>
        A first call for {service.name.toLowerCase()} in {CONTACT.address.locality} starts with the four stages below.
        Nothing is fitted, dug or replaced without being quoted first, and the price is confirmed before work begins.
      </p>
      <div class="not-prose my-8">
        <ProcessSteps steps={service.process} headingLevel={3} />
      </div>

      {service.editorial.map((e) => (
        <>
          <h2>{e.h2}</h2>
          {e.body.map((p) => <p>{p}</p>)}
        </>
      ))}

      <h2>When this service is the right call</h2>
      <p>
        The signals below are the ones that bring most {CONTACT.address.locality} properties to this service. Any one of
        them is worth a call; several together usually mean the system is already past the point where waiting is cheap.
      </p>
      <ul>
        {service.symptoms.map((s) => <li>{s}</li>)}
      </ul>

      <h2>What is included</h2>
      <p>
        Every {service.name.toLowerCase()} visit covers all eight of these. They are not tiers or add-ons — the list is
        what the job is.
      </p>
      <ul>
        {service.whatsIncluded.map((s) => <li>{s}</li>)}
      </ul>

      <h2>Paying for it, and what the alternative costs</h2>
      <p>{service.priceBasis}</p>
      <p>
        For scale: a drain field replacement in Middle Tennessee is commonly quoted at $6,000 to $10,000, against
        published 2026 national figures of roughly $5,000 to $20,000. The whole economic case for maintaining a septic
        system is the gap between those two numbers. Pricing here is confirmed on site before work starts, and the
        <a href="/tools/septic-pumping-cost-estimator/"> cost estimator</a> shows the full formula rather than asking
        for contact details first.
      </p>

      <h2>Doing it properly versus doing it cheaply</h2>
      <p>
        The invoice for a thorough job and a rushed one look similar. What separates them is whether the tank was
        emptied to the floor, whether anyone looked at the baffles while it was open, and whether the property owner
        ends up knowing anything they did not know before.
      </p>
      <div class="not-prose my-8">
        <ComparisonTable />
      </div>

      <div class="not-prose my-10">
        <RelatedGuides slugs={service.guideSlugs} heading="Related resources" headingLevel={2} />
      </div>

      <h2>Frequently asked questions</h2>
      <div class="not-prose mt-6">
        <FaqAccordion faqs={faqs} headingLevel={3} />
      </div>
    </article>

    <!-- ── STICKY SIDEBAR ──────────────────────────────────────────────── -->
    <aside class="lg:sticky lg:top-28 lg:self-start">
      <div class="card border-l-4 border-l-alert p-5">
        <p class="font-display text-lg font-bold uppercase tracking-wide text-alert">Sewage in the house?</p>
        <p class="mt-2 text-[1rem] leading-relaxed text-ink-soft">
          Stop using water completely and call. Backups get priority dispatch ahead of the scheduled queue.
        </p>
        <a href={tel} class="btn btn-accent mt-4 w-full" data-cta="sidebar-emergency">
          <Icon name="phone" size={20} /> {CONTACT.phoneDisplay}
        </a>
        <a href="/emergency-septic-service/" class="mt-3 flex min-h-11 items-center justify-center text-center font-semibold underline">
          Emergency septic service →
        </a>
      </div>

      <div class="card mt-6 p-5">
        <p class="font-display text-lg font-bold uppercase tracking-wide text-primary-dark">Standards this work follows</p>
        <hr class="rule-accent" />
        <ul class="mt-4 space-y-2 text-[0.98rem] leading-relaxed text-ink-soft">
          {KNOWS_ABOUT.slice(0, 8).map((k) => (
            <li class="flex items-start gap-2">
              <Icon name="check" size={16} class="mt-1 shrink-0 text-primary-light" />
              <span>{k}</span>
            </li>
          ))}
        </ul>
        <div class="mt-5 border-t border-line pt-4">
          <CredentialList />
        </div>
      </div>

      <div class="card mt-6 p-5">
        <p class="font-display text-lg font-bold uppercase tracking-wide text-primary-dark">Free tools</p>
        <hr class="rule-accent" />
        <ul class="mt-4 space-y-3">
          <li>
            <a href="/tools/septic-pumping-cost-estimator/" class="link-row font-semibold">Septic pumping cost estimator →</a>
            <p class="text-sm text-ink-soft">A price range in three questions, formula shown.</p>
          </li>
          <li>
            <a href="/tools/septic-system-assessment/" class="link-row font-semibold">Urgency assessment →</a>
            <p class="text-sm text-ink-soft">Nine questions, an urgency level, and what to do next.</p>
          </li>
          <li>
            <a href="/resources/" class="link-row font-semibold">Pre-hire checklist (free) →</a>
            <p class="text-sm text-ink-soft">The questions to ask before booking any septic contractor.</p>
          </li>
        </ul>
      </div>
    </aside>
  </div>

  <section id="book" class="section section-alt">
    <div class="container-site grid gap-10 lg:grid-cols-[1fr_1fr]">
      <div>
        <SectionHead
          eyebrow="Book it"
          heading={`Book ${service.name.toLowerCase()} in ${CONTACT.address.locality}`}
          lede="Call and a person takes the details, or send the property details and get a call back with a price. Either route ends with the same thing: a confirmed price before any work starts."
        />
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a href={tel} class="btn btn-accent" data-cta="service-book-call">
            <Icon name="phone" size={22} /> Call {CONTACT.phoneDisplay}
          </a>
          <a href="/contact/" class="btn btn-outline">Contact page</a>
        </div>
        <div class="mt-10">
          <RelatedServices slugs={service.relatedServices} headingLevel={2} />
        </div>
      </div>
      <LeadCaptureForm source={`service:${service.slug}`} submitLabel={`Book ${service.shortName.toLowerCase()}`} />
    </div>
  </section>

  <CtaBand
    heading={`${service.name} in ${CONTACT.address.locality} — get it scheduled`}
    body={`Covering ${CONTACT.serviceArea}. Backups take priority; routine work is usually same-day or next-day.`}
    callLabel={`Call ${CONTACT.phoneDisplay}`}
    secondaryLabel="Send property details"
    secondaryHref="#book"
  />
</Base>
