---
interface Props { trail: { name: string; href: string }[] }
const { trail } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-[14px] text-ink-soft">
  <ol class="flex flex-wrap items-center gap-1.5">
    {trail.map((t, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="text-hairline">/</span>}
        {i === trail.length - 1
          ? <span aria-current="page" class="text-ink">{t.name}</span>
          : <a href={t.href} class="tap-link underline underline-offset-2 hover:text-accent-dark">{t.name}</a>}
      </li>
    ))}
  </ol>
</nav>
