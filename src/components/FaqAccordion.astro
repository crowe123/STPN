---
/**
 * Visible Q&A, mirrored 1:1 into FAQPage schema by the calling page.
 * Native <details> — no JavaScript.
 */
import type { Faq } from '../lib/data';

interface Props { faqs: Faq[]; headingLevel?: 3 | 4 }
const { faqs, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}` as 'h3' | 'h4';
---
<div class="divide-y divide-line border-y border-line">
  {
    faqs.map((f, i) => (
      <details name="faq" open={i === 0} class="group">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5">
          <H class="text-lg leading-snug md:text-xl">{f.q}</H>
          <span
            aria-hidden="true"
            class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-sm border-2 border-primary font-display text-xl font-bold leading-none text-primary transition group-open:rotate-45"
          >
            +
          </span>
        </summary>
        <p class="max-w-3xl pb-6 text-[1.0625rem] leading-relaxed text-ink-soft">{f.a}</p>
      </details>
    ))
  }
</div>
