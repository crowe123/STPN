---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TickerBar from '../components/TickerBar.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import RelatedServices from '../components/RelatedServices.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import CtaBand from '../components/CtaBand.astro';
import LeadCaptureForm from '../components/LeadCaptureForm.astro';
import CredentialList from '../components/CredentialList.astro';
import { BRAND, CONTACT, SITE } from '../config';
import { abs, tel, fmtDate, money } from '../lib/site';
import { graph, organizationNode, websiteNode, webPageNode, breadcrumbNode, faqNode, serviceNode, howToNode } from '../lib/schema';
import servicesData from '../data/services.json';

export function getStaticPaths() {
  return servicesData.services
    .filter((s) => s.slug)
    .map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service: s } = Astro.props;
const path = `/${s.slug}/`;

/* One global question appears on every service page alongside the four specific
   ones, per the template. It is answered from real published price data. */
const globalFaq = {
  q: 'How do you price the work, and will the price change once you are here?',
  a: 'You get a range before we come out, based on your tank size and how buried the lids are. Tennessee pumping runs $275–$525 and Davidson County figures span $199–$796, so the honest answer is that access and capacity move it. If we open the tank and find something that changes the job — compacted sludge needing a clean, a corroded baffle, a split effluent filter — we tell you what it costs and let you decide before we do it. We do not do the work and present the bill afterwards.',
};
const faq = [...s.faq, globalFaq];

const title = `${s.name} ${CONTACT.address.locality} | Upfront Pricing | ${SITE.titleSuffix}`;
const trail = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services-menu/' },
  { name: s.name, href: path },
];
const schema = graph([
  organizationNode(), websiteNode(),
  webPageNode(path, title, s.metaDescription, SITE.lastReviewed),
  breadcrumbNode(path, trail), serviceNode(s), howToNode(s), faqNode(path, faq),
]);
const heroImg = `/images/services/${s.slug}-hero.webp`;
---
<BaseLayout title={title} description={s.metaDescription} path={path} schema={schema} heroPreload={heroImg}>
  <section class="border-b border-hairline">
    <div class="container-page pt-6 pb-12 md:pb-16">
      <Breadcrumbs trail={trail} />
      <div class="mt-6 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center">
        <div>
          <h1 class="text-[2rem] leading-[1.13] md:text-5xl">{s.heroH1}</h1>
          <p class="mt-5 text-lg md:text-xl leading-relaxed text-ink-soft">{s.blurb}</p>
          <div class="mt-7 flex flex-col sm:flex-row gap-3">
            <a href={tel} class="btn btn-accent text-lg px-7">Call {CONTACT.phoneDisplay}</a>
            <a href="/tools/septic-pumping-cost-estimator/" class="btn btn-ghost text-primary text-lg px-7">Estimate the cost</a>
          </div>
          <p class="mt-6 font-heading font-bold text-2xl text-primary">from {money(s.priceFrom)}</p>
          <p class="text-[15px] text-ink-soft">{s.priceRange}</p>
        </div>
        <img src={heroImg} alt={`${s.name} in ${CONTACT.address.locality}, ${CONTACT.address.region}`}
             width="1280" height="720" fetchpriority="high" decoding="async" loading="eager"
             class="w-full h-auto rounded-lg border border-hairline shadow-sm" />
      </div>
    </div>
  </section>

  <TickerBar />

  <div class="container-page py-14 grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-14">
    <article class="prose-article">
      <p class="text-[14px] text-ink-soft">Last updated: {fmtDate(SITE.lastReviewed)}</p>
      <p>
        <a href="/">{BRAND.name}</a> is a septic tank pumping company serving {CONTACT.serviceArea}, Tennessee,
        and {s.name.toLowerCase()} is one of the services it provides across the county. {s.blurb}
      </p>

      <h2>When people call us about this</h2>
      <p>These are the situations that bring most {s.name.toLowerCase()} calls in:</p>
      <ul>{s.symptoms.map((sym: string) => <li>{sym}</li>)}</ul>

      <h2>What is included</h2>
      <p>
        Every {s.name.toLowerCase()} job includes all of the following. Nothing on this list is an
        upsell presented once we are on site.
      </p>
      <ul>{s.whatsIncluded.map((w: string) => <li>{w}</li>)}</ul>

      <h2>What it costs, and what moves the price</h2>
      <p>{s.priceBasis}</p>
      <p>
        The published range for this service is <strong>{s.priceRange}</strong>. We give you a band
        before we come out and a firm number before we do anything that changes it. If you want a
        figure right now without talking to anyone, the
        <a href="/tools/septic-pumping-cost-estimator/">cost estimator</a> takes three questions.
      </p>
    </article>

    <aside class="lg:sticky lg:top-28 space-y-5 self-start">
      <div class="card p-6 bg-primary text-white">
        <p class="font-heading font-bold text-lg">Septic emergency?</p>
        <p class="mt-2 text-[15px] text-white/85">{CONTACT.hoursHuman}</p>
        <a href={tel} class="btn bg-white text-primary-dark hover:bg-white/90 w-full mt-4">Call {CONTACT.phoneDisplay}</a>
      </div>
      <div class="card p-6">
        <p class="font-heading font-bold">Standards this work follows</p>
        <ul class="mt-3 space-y-2 text-[14.5px] text-ink-soft">
          <li>Tenn. Comp. R. &amp; Regs. 0400-48-01-.20 — septic tank pumping contractors</li>
          <li>TDEC Subsurface Sewage Disposal Program</li>
          <li>Davidson County as a TDEC contract county</li>
          <li>Metro Public Health, Environmental Engineering Services</li>
        </ul>
      </div>
      <CredentialList />
      <LeadCaptureForm source={`service-${s.slug}`} compact
        heading="Get a price for this" body="Two quick steps. We reply with a firm number." />
    </aside>
  </div>

  <ProcessSteps steps={s.process} heading={`How ${s.name.toLowerCase()} runs, start to finish`} />
  <ComparisonTable />
  <RelatedGuides slugs={s.guideSlugs} heading="Worth reading before you book" />
  <CtaBand heading={`Need ${s.name.toLowerCase()} in ${CONTACT.address.locality}?`}
           body="Call for a price, or use the estimator if you would rather not talk to anyone yet."
           ctaLabel="Get a price" />
  <FaqAccordion faq={faq} heading={`${s.name} — questions people ask`} />
  <RelatedServices slugs={s.relatedServices} />
</BaseLayout>
