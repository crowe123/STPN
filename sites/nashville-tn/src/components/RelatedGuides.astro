---
import { getCollection } from 'astro:content';
interface Props { slugs: string[]; heading?: string; columns?: 2 | 3 }
const { slugs, heading = 'Related resources', columns = 2 } = Astro.props;
const all = await getCollection('guides');
const list = slugs.map((s) => all.find((g) => g.id === s)).filter(Boolean) as any[];
---
{list.length > 0 && (
  <section class="container-page py-14">
    <h2 class="text-2xl md:text-3xl">{heading}</h2>
    <div class={`mt-6 grid gap-4 ${columns === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2'}`}>
      {list.map((g) => (
        <a href={`/guide/${g.id}/`} class="card card-hover p-5">
          <p class="text-[12px] font-bold uppercase tracking-wide text-accent-dark">{g.data.badge}</p>
          <p class="mt-1.5 font-heading font-bold text-lg">{g.data.h1}</p>
          <p class="mt-2 text-[15px] text-ink-soft">{g.data.dek}</p>
        </a>
      ))}
    </div>
  </section>
)}
