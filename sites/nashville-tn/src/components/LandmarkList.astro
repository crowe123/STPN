---
interface Props { landmarks: string[]; routes: string[]; cityName: string; responseTime: string }
const { landmarks, routes, cityName, responseTime } = Astro.props;
---
<div class="grid gap-8 sm:grid-cols-2">
  <div>
    <p class="font-heading font-bold text-lg">Around {cityName}</p>
    <ul class="mt-3 space-y-2 text-[15px] text-ink-soft">
      {landmarks.map((l) => (
        <li class="flex gap-2.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-accent shrink-0 mt-1" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>{l}</span>
        </li>
      ))}
    </ul>
  </div>
  <div>
    <p class="font-heading font-bold text-lg">How we reach you</p>
    <ul class="mt-3 space-y-2 text-[15px] text-ink-soft">
      {routes.map((r) => (
        <li class="flex gap-2.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-accent shrink-0 mt-1" aria-hidden="true"><path d="M3 12h18M15 6l6 6-6 6"/></svg>
          <span>{r}</span>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-[15px]">{responseTime}</p>
  </div>
</div>
