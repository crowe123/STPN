---
import { CONTACT } from '../config';
import { tel } from '../lib/site';
interface Props {
  h1: string; sub: string; badge?: string;
  tiles?: string[]; image?: string; imageAlt?: string;
  ctaSecondaryLabel?: string; ctaSecondaryHref?: string;
}
const {
  h1, sub, badge, tiles = [], image, imageAlt = '',
  ctaSecondaryLabel = 'Get a free estimate', ctaSecondaryHref = '/contact/',
} = Astro.props;
---
<section class="border-b border-hairline">
  <div class="container-page py-12 md:py-16 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center">
    <div>
      {badge && <p class="inline-block rounded-full bg-accent/12 text-accent-dark font-bold text-[13px] uppercase tracking-wide px-3.5 py-1.5">{badge}</p>}
      <h1 class="mt-4 text-[2.1rem] leading-[1.12] md:text-5xl lg:text-[3.4rem]">{h1}</h1>
      <p class="mt-5 text-lg md:text-xl leading-relaxed text-ink-soft max-w-2xl">{sub}</p>
      <div class="mt-7 flex flex-col sm:flex-row gap-3">
        <a href={tel} class="btn btn-accent text-lg px-7">Call {CONTACT.phoneDisplay}</a>
        <a href={ctaSecondaryHref} class="btn btn-ghost text-primary text-lg px-7">{ctaSecondaryLabel}</a>
      </div>
      {tiles.length > 0 && (
        <ul class="mt-8 grid grid-cols-2 gap-3 max-w-xl">
          {tiles.map((t) => (
            <li class="flex items-start gap-2.5 text-[15px]">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" class="text-accent shrink-0 mt-0.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              <span>{t}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
    {image && (
      <img src={image} alt={imageAlt} width="1280" height="720"
           fetchpriority="high" decoding="async" loading="eager"
           class="w-full h-auto rounded-lg border border-hairline shadow-sm" />
    )}
  </div>
</section>
