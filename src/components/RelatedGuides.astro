---
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';

interface Props {
  /** Guide ids (filenames without extension). */
  slugs: string[];
  heading?: string;
  headingLevel?: 2 | 3;
  lede?: string;
}
const { slugs, heading = 'Related resources', headingLevel = 2, lede } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
const HSub = `h${headingLevel + 1}` as 'h3' | 'h4';

// Always read from the collection — never a hardcoded array left in from scaffolding.
const all = await getCollection('guides');
const list = slugs.map((s) => all.find((g) => g.id === s)).filter(Boolean);
---
{
  list.length > 0 && (
    <div>
      <H class="text-2xl md:text-3xl">{heading}</H>
      <hr class="rule-accent" />
      {lede && <p class="mt-4 max-w-3xl text-lg text-ink-soft">{lede}</p>}
      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        {list.map((g) => (
          <li class="card card-hover">
            <a href={`/guide/${g!.id}/`} class="flex h-full flex-col p-5">
              <span class="font-display text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">
                {g!.data.badge}
              </span>
              <HSub class="mt-1.5 text-lg leading-snug text-primary-dark">{g!.data.cardTitle ?? g!.data.h1}</HSub>
              <p class="mt-2 flex-1 text-[1rem] leading-relaxed text-ink-soft">{g!.data.dek}</p>
              <p class="mt-3 inline-flex items-center gap-2 font-display text-sm font-bold uppercase tracking-widest text-primary-light">
                Read the guide <Icon name="arrow" size={16} />
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
