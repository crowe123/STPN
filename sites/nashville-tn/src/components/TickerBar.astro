---
/* Facts about the work and the rules governing it — true regardless of company
   age. Never company credentials. Rendered as a list, not headings. */
const facts = [
  'Tenn. Comp. R. & Regs. 0400-48-01-.20 governs septic pumping contractors',
  'Davidson County administers its own septic program as a TDEC contract county',
  'Tennessee guidance: pump every 3–5 years',
  'Grease traps serviced every 30 days · interceptors every 90',
  'Sludge and scum depth recorded on every visit',
];
---
<div class="bg-primary-dark text-white/85 text-[13.5px]">
  <div class="container-page py-3">
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
      {facts.map((f) => (
        <li class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-accent shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
          <span>{f}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
