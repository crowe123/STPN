---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE, CONTACT } from '../../config';
import { graph, organizationNode, websiteNode, webPageNode, breadcrumbNode } from '../../lib/schema';
const path = '/tools/';
const title = `Free Septic Tools & Calculators | ${SITE.titleSuffix}`;
const description = 'Two free septic tools for Davidson County homeowners: a three-question cost estimator and a nine-question urgency assessment. No email required.';
const trail = [{ name: 'Home', href: '/' }, { name: 'Free Tools', href: path }];
const schema = graph([organizationNode(), websiteNode(), webPageNode(path, title, description, SITE.lastReviewed), breadcrumbNode(path, trail)]);
---
<BaseLayout title={title} description={description} path={path} schema={schema}>
  <section class="container-page pt-6 pb-10 border-b border-hairline">
    <Breadcrumbs trail={trail} />
    <h1 class="mt-6 text-[2rem] md:text-5xl leading-[1.13]">Free Septic Tools</h1>
    <p class="mt-5 max-w-3xl text-lg md:text-xl text-ink-soft leading-relaxed">
      Both of these give you an answer immediately. Neither asks for an email address to show you the
      result, because gating the answer behind a form is a way of not answering.
    </p>
  </section>
  <section class="container-page py-14 grid gap-6 md:grid-cols-2">
    <a href="/tools/septic-pumping-cost-estimator/" class="card card-hover p-8">
      <p class="font-heading font-bold text-2xl">Septic Pumping Cost Estimator</p>
      <p class="mt-3 text-lg text-ink-soft">
        Tank size, how buried the lids are, how long since the last pump. Three questions and you get
        a real range — built from published Tennessee and Davidson County figures, with a breakdown of
        what your pumping is protecting against.
      </p>
      <p class="mt-5 font-semibold text-accent-dark">Open the estimator →</p>
    </a>
    <a href="/tools/septic-system-assessment/" class="card card-hover p-8">
      <p class="font-heading font-bold text-2xl">Septic Urgency Assessment</p>
      <p class="mt-3 text-lg text-ink-soft">
        Nine plain questions about what your system is doing. You get a severity reading, what it
        means, and the specific next steps — including what to stop doing right now if it is serious.
      </p>
      <p class="mt-5 font-semibold text-accent-dark">Start the assessment →</p>
    </a>
  </section>
  <CtaBand heading="Tools are a starting point. A firm price needs a conversation."
           body={`Call ${CONTACT.phoneDisplay} and we will give you one.`} ctaLabel="Get a price" />
</BaseLayout>
