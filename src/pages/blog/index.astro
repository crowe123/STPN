---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { graph, organization, website, webPage, breadcrumbs } from '../../lib/schema';

const path = '/blog/';
const title = 'Septic Blog — Nashville & Davidson County | 615 Septic Tank Pumping';
const description =
  'Seasonal septic alerts, how the work actually runs, Tennessee code notes and scheduling guidance for Nashville and Davidson County property owners.';
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path },
];
const schema = graph([organization(), website(), webPage({ path, title, description }), breadcrumbs(trail)]);

// Always read from the collection — never a hardcoded array.
const posts = (await getCollection('blog')).sort((a, b) =>
  b.data.datePublished.localeCompare(a.data.datePublished)
);
---
<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs trail={trail} />
  <section class="bg-offwhite py-12 md:py-16">
    <div class="container-site">
      <p class="eyebrow">{posts.length} posts</p>
      <h1 class="mt-2 font-display text-[2.4rem] leading-[1.06] text-primary-dark sm:text-5xl">
        Septic Notes for Nashville Property Owners
      </h1>
      <hr class="rule-accent" />
      <p class="mt-6 max-w-3xl text-xl leading-relaxed text-ink">
        Seasonal warnings tied to Middle Tennessee ground conditions, walkthroughs of how the work actually runs,
        summaries of the Tennessee rules that reach a homeowner, and practical scheduling advice.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <ul class="grid gap-6 md:grid-cols-2">
        {
          posts.map((p) => (
            <li class="card card-hover">
              <a href={`/blog/${p.id}/`} class="flex h-full flex-col p-6">
                <span class="font-display text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">
                  {p.data.category}
                </span>
                <h2 class="mt-2 text-2xl leading-snug text-primary-dark">{p.data.h1}</h2>
                <p class="mt-3 flex-1 text-[1.0625rem] leading-relaxed text-ink-soft">{p.data.dek}</p>
                <p class="mt-4 text-sm text-ink-soft">Published {p.data.datePublished}</p>
                <p class="mt-2 inline-flex items-center gap-2 font-display text-sm font-bold uppercase tracking-widest text-primary-light">
                  Read the post <Icon name="arrow" size={16} />
                </p>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-10">
        <a href="/guide/" class="btn btn-outline">Looking for costs and permits? The guides →</a>
      </p>
    </div>
  </section>

  <CtaBand
    heading="Need a septic tank pumped, not an article?"
    body="Call and a person takes the details. Price confirmed before any work starts."
    secondaryLabel="Book a pump-out"
  />
</Base>
