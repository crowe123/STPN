---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCallBar from '../components/StickyCallBar.astro';
import { BRAND, SITE, ANALYTICS, TOKENS, abs } from '../config';

export interface Props {
  title: string;
  description: string;
  /** Path with leading and trailing slash, e.g. '/service-areas/bellevue/' */
  path: string;
  /** Page-level JSON-LD @graph object. */
  schema?: unknown;
  /** Absolute or root-relative OG image. Defaults to the site-wide card. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Set on the article/guide pages so social cards show the right type. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Extra <head> markup (hero preload). */
  bodyClass?: string;
}

const {
  title,
  description,
  path,
  schema,
  ogImage = '/images/og-default.png',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  bodyClass = '',
} = Astro.props;

const canonical = abs(path);
const ogImageAbs = abs(ogImage);
// Every page advertises a markdown mirror; '/x/' → '/x.md', '/' → '/index.md'.
const mdHref = abs(path === '/' ? '/index.md' : `${path.replace(/\/$/, '')}.md`);
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content={TOKENS.primary} />
    <meta name="format-detection" content="telephone=yes" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${BRAND.name} — ${BRAND.tagline}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Agent/AI discovery: every page has a markdown mirror. -->
    <link rel="alternate" type="text/markdown" href={mdHref} title={`${title} (markdown)`} />
    <link rel="alternate" type="application/xml" href={abs('/sitemap-index.xml')} title="Sitemap" />

    <slot name="head" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Analytics ships live, not commented out. Provider + id in src/config.ts. -->
    {
      ANALYTICS.provider === 'plausible' && (
        <script defer data-domain={ANALYTICS.id} src="https://plausible.io/js/script.js" />
      )
    }
    {
      ANALYTICS.provider === 'ga4' && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.id}`} />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${ANALYTICS.id}');`}
          />
        </>
      )
    }

    <!-- Agent-ready WebMCP shim. Defer, silent no-op where unsupported. -->
    <script defer src="/agent-ready-webmcp.js"></script>
  </head>

  <body class={bodyClass}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded focus:bg-primary focus:px-4 focus:py-3 focus:text-white"
      >Skip to content</a
    >
    <Header currentPath={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyCallBar />
  </body>
</html>
