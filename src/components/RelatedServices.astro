---
import Icon from './Icon.astro';
import { serviceBySlug } from '../lib/data';

interface Props { slugs: string[]; heading?: string; headingLevel?: 2 | 3 }
const { slugs, heading = 'Related services', headingLevel = 2 } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
const HSub = `h${headingLevel + 1}` as 'h3' | 'h4';
const list = slugs.map(serviceBySlug).filter(Boolean);
---
{
  list.length > 0 && (
    <div>
      <H class="text-2xl md:text-3xl">{heading}</H>
      <hr class="rule-accent" />
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {list.map((s) => (
          <a href={`/${s!.slug}/`} class="card card-hover block p-5">
            <HSub class="text-lg leading-snug text-primary-dark">{s!.name}</HSub>
            <p class="mt-2 text-[1rem] leading-relaxed text-ink-soft">{s!.blurb}</p>
            <p class="mt-3 inline-flex items-center gap-2 font-display text-sm font-bold uppercase tracking-widest text-accent-dark">
              View service <Icon name="arrow" size={16} />
            </p>
          </a>
        ))}
      </div>
    </div>
  )
}
