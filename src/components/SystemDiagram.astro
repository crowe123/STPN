---
/**
 * Cross-section of a conventional gravity septic system.
 *
 * This is real explanatory artwork, not a placeholder standing in for a photo:
 * it names the components the rest of the site refers to (inlet and outlet
 * baffles, the three layers inside the tank, the distribution box, the
 * laterals) so the copy has something to point at. The drawing lives in
 * /images/septic-system-cross-section.svg rather than inline — it repeats on
 * most pages, so shipping it as one cached file keeps it out of every document.
 */
interface Props { class?: string; compact?: boolean }
const { class: className = '' } = Astro.props;
---
<figure class={className}>
  <img
    src="/images/septic-system-cross-section.svg"
    alt="Cross-section of a conventional septic system: waste leaves the house through the building drain and enters the tank at the inlet baffle, separating into a floating scum layer, a clear effluent zone, and settled sludge. Only the clear middle layer passes the outlet baffle to the distribution box and drain field laterals. Pumping removes the scum and sludge layers."
    width="900"
    height="440"
    class="h-auto w-full"
    loading="eager"
    decoding="async"
  />
</figure>
